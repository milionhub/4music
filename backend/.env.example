# Copia este archivo a backend/.env (no se versiona).
# Contacto (email o URL) que MusicBrainz exige en el User-Agent. Sin él, /v1/* responde 503 provider_not_configured.
MUSICBRAINZ_CONTACT=tu-email-o-url-de-contacto
# Opcional: Groq (solo backend; la clave nunca va a la app). Sin clave, las biografías generadas y Carteles no se activan.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# Modelo de visión de Carteles (en preview; comprobar disponibilidad) y límite de análisis por IP y día.
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# POSTER_DAILY_LIMIT=30
