# Copiar a .env (ignorado por Git). No poner valores reales en este archivo.
# Contacto para el User-Agent que exigen MusicBrainz y Wikimedia (email o URL).
MUSIC_RESEARCH_CONTACT=
# Discogs (Fase 1.3): token personal; se envía solo en la cabecera Authorization a api.discogs.com.
# Nunca lo pongas en URLs, logs ni archivos versionados. Sin token, run_phase13.py omite Discogs.
DISCOGS_TOKEN=
