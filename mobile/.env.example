# Copia este archivo a .env (no se versiona) y ajusta la URL.
# Solo valores públicos: todo EXPO_PUBLIC_* queda visible dentro de la app.
# Nunca uses localhost/127.0.0.1: en el móvil apuntan al propio móvil.
#
# Emulador Android: 10.0.2.2 es el localhost del PC visto desde el emulador.
EXPO_PUBLIC_API_URL=http://192.168.1.38:8000
#
# iPhone / dispositivo físico en la misma Wi-Fi: sustituye la línea anterior
# por la IP LAN del PC (ver README, sección iPhone) y arranca el backend con
# --host 0.0.0.0. Ejemplo con marcador, reemplaza <IP-LAN-DEL-PC>:
# EXPO_PUBLIC_API_URL=http://<IP-LAN-DEL-PC>:8000
#
# Tras cambiarla, recarga la app (tecla r en Expo); si no se aplica,
# reinicia con: npx expo start --clear
